{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?__route=$1" },
    { "source": "/api", "destination": "/api/index.js?__route=" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    }
  }
}
